{
  "name": "@niche-works/rollup-plugin-dist-package",
  "version": "0.2.0",
  "keywords": [
    "rollup",
    "plugin",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mitsuhiroseino/niche-works-rollup-plugin-dist-package.git"
  },
  "license": "MIT",
  "author": "Mitsuhiro Seino",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "sort-package-json": "^3.6.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup": "^4.40.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "unrun": "^0.3.0"
  },
  "peerDependencies": {
    "rollup": "^4.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
